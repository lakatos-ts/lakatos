{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lakatos.test/schemas/thales-emission.schema.json",
  "title": "Thales Emission",
  "description": "One module's plain-Lean emission input: the mappable declarations of one annotated TypeScript file and the proof obligations over them, in source order. Produced by the frontend, consumed by the thales-emit executable, which renders it as a readable .lean artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "declarations", "obligations"],
  "properties": {
    "file": {
      "type": "string",
      "description": "The annotations' identity file, as given to the frontend."
    },
    "declarations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/function" },
          { "$ref": "#/definitions/class" },
          { "$ref": "#/definitions/constant" },
          { "$ref": "#/definitions/residual" }
        ]
      }
    },
    "obligations": {
      "type": "array",
      "items": { "$ref": "#/definitions/obligation" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[$A-Za-z_][$A-Za-z0-9_]*$"
    },
    "fieldName": {
      "type": "string",
      "description": "A class field's source spelling; a '#'-private keeps its sigil, which the artifact renders as one guillemeted name component.",
      "pattern": "^#?[$A-Za-z_][$A-Za-z0-9_]*$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/fieldName" },
        "type": {
          "description": "Present exactly for a boolean, union-typed, or class-typed field; absent means number, the rule a local statement follows.",
          "oneOf": [
            { "const": "boolean" },
            { "$ref": "#/definitions/unionTags" },
            { "$ref": "#/definitions/classRef" }
          ]
        }
      }
    },
    "modulePath": {
      "type": "string",
      "description": "A dependency's path relative to the entry file, posix-spelled. Absent on a declaration or call means the entry file itself. Guillemets and control characters are excluded: the path is rendered as one Lean name component between guillemets, and either would break it.",
      "pattern": "^(?!/)[^\\u0000-\\u001f\\u00ab\\u00bb]+$"
    },
    "unionTags": {
      "type": "array",
      "description": "A keyword union's normalized spelling: its keyword-member tags, deduplicated and sorted number, string, bigint, boolean, undefined, null; at least two.",
      "minItems": 2,
      "items": {
        "enum": ["number", "string", "bigint", "boolean", "undefined", "null"]
      }
    },
    "paramType": {
      "description": "A parameter's slot type: a TypeScript number, a boolean, a keyword union, an instance of a modeled class, or — for a defaulted class parameter — an option of one.",
      "oneOf": [
        { "const": "number" },
        { "const": "boolean" },
        { "$ref": "#/definitions/unionTags" },
        { "$ref": "#/definitions/classRef" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["option"],
          "properties": {
            "option": { "$ref": "#/definitions/classRef" }
          }
        }
      ]
    },
    "classRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "$ref": "#/definitions/identifier" },
        "module": { "$ref": "#/definitions/modulePath" }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/definitions/identifier" },
        "type": { "$ref": "#/definitions/paramType" }
      }
    },
    "ctorParamNode": {
      "description": "One constructor parameter of a class binder's class. A class-typed parameter carries its own parameters, so the tree bottoms out in numbers and booleans; the constructor-parameter graph is acyclic, so it terminates.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "$ref": "#/definitions/identifier" },
            "kind": { "const": "number" },
            "defaulted": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "$ref": "#/definitions/identifier" },
            "kind": { "const": "boolean" },
            "defaulted": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "className", "ctorParams"],
          "properties": {
            "name": { "$ref": "#/definitions/identifier" },
            "kind": { "const": "class" },
            "className": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "ctorParams": {
              "type": "array",
              "items": { "$ref": "#/definitions/ctorParamNode" }
            },
            "defaulted": { "const": true }
          }
        }
      ]
    },
    "floatBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "lit"],
      "description": "One side of a number binder's interval: the comparison against the bound variable, and the endpoint literal — a finite double, or Infinity / -Infinity for an unbounded side.",
      "properties": {
        "op": { "enum": ["<", "<="] },
        "lit": { "type": "string" }
      }
    },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "lit"],
          "properties": {
            "kind": { "const": "num" },
            "lit": {
              "type": "string",
              "description": "The literal as JavaScript prints the double it denotes; a leading '-' folds a negation in."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "id" },
            "name": { "$ref": "#/definitions/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "op", "operand"],
          "properties": {
            "kind": { "const": "unop" },
            "op": { "enum": ["-", "+", "!"] },
            "operand": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "op", "left", "right"],
          "properties": {
            "kind": { "const": "binop" },
            "op": {
              "enum": [
                "+",
                "-",
                "*",
                "/",
                "%",
                "<",
                "<=",
                ">",
                ">=",
                "===",
                "!==",
                "||",
                "&&"
              ]
            },
            "left": { "$ref": "#/definitions/expr" },
            "right": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "Object.is on numbers: ECMA-262 SameValue.",
          "additionalProperties": false,
          "required": ["kind", "left", "right"],
          "properties": {
            "kind": { "const": "same-value" },
            "left": { "$ref": "#/definitions/expr" },
            "right": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A conditional expression: the condition is boolean-valued, and both arms answer at the position's own type.",
          "additionalProperties": false,
          "required": ["kind", "cond", "then", "else"],
          "properties": {
            "kind": { "const": "cond" },
            "cond": { "$ref": "#/definitions/expr" },
            "then": { "$ref": "#/definitions/expr" },
            "else": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A whitelisted standard-library member call, by the object and member the source names: Math.sqrt, Math.abs, Math.trunc, Math.floor, Math.ceil, Math.round, Math.sign, Math.fround, Math.min, Math.max, Number.isFinite, Number.isNaN, Number.isInteger, Number.isSafeInteger. The arguments are the call site's, so a variadic member carries as many as it was written with; the renderer owns what each pair means and how it folds them.",
          "additionalProperties": false,
          "required": ["kind", "object", "member", "args"],
          "properties": {
            "kind": { "const": "builtin" },
            "object": { "enum": ["Math", "Number"] },
            "member": { "$ref": "#/definitions/identifier" },
            "args": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          }
        },
        {
          "type": "object",
          "description": "A whitelisted standard-library member read, by the object and member the source names: the Number constants ECMA-262 fixes — Number.EPSILON, Number.MAX_SAFE_INTEGER, Number.MIN_SAFE_INTEGER, Number.MAX_VALUE, Number.MIN_VALUE, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY, Number.NaN, Math.E, Math.LN10, Math.LN2, Math.LOG10E, Math.LOG2E, Math.PI, Math.SQRT1_2, Math.SQRT2. A read carries no arguments; the renderer owns what each pair means.",
          "additionalProperties": false,
          "required": ["kind", "object", "member"],
          "properties": {
            "kind": { "const": "builtin-read" },
            "object": { "enum": ["Math", "Number"] },
            "member": { "$ref": "#/definitions/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "callee", "args"],
          "properties": {
            "kind": { "const": "call" },
            "callee": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "args": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          }
        },
        {
          "type": "object",
          "description": "Instance construction: a lifted call of the class's construct model.",
          "additionalProperties": false,
          "required": ["kind", "className", "args"],
          "properties": {
            "kind": { "const": "new" },
            "className": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "args": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          }
        },
        {
          "type": "object",
          "description": "A getter read on an instance: a lifted call of the getter model.",
          "additionalProperties": false,
          "required": ["kind", "className", "name", "object"],
          "properties": {
            "kind": { "const": "getter-read" },
            "className": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "name": { "$ref": "#/definitions/identifier" },
            "object": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A field projection on an instance; private '#' spellings included.",
          "additionalProperties": false,
          "required": ["kind", "className", "field", "object"],
          "properties": {
            "kind": { "const": "field-read" },
            "className": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "field": { "$ref": "#/definitions/fieldName" },
            "object": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A method call: the receiver's method applied to the receiver and the arguments, receiver first.",
          "additionalProperties": false,
          "required": ["kind", "className", "name", "object", "args"],
          "properties": {
            "kind": { "const": "method-call" },
            "className": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" },
            "name": { "$ref": "#/definitions/identifier" },
            "object": { "$ref": "#/definitions/expr" },
            "args": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          }
        },
        {
          "type": "object",
          "description": "The receiver inside a getter body.",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "self" } }
        },
        {
          "type": "object",
          "description": "A read of a module-level constant: a reference to that constant's def.",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "const-read" },
            "name": { "$ref": "#/definitions/identifier" },
            "module": { "$ref": "#/definitions/modulePath" }
          }
        },
        {
          "type": "object",
          "description": "An injection into the JsVal domain; 'expr' is present exactly for the payload-carrying 'number' and 'boolean' tags, absent for 'undefined'/'null'.",
          "additionalProperties": false,
          "required": ["kind", "tag"],
          "properties": {
            "kind": { "const": "inject" },
            "tag": { "enum": ["number", "boolean", "undefined", "null"] },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A throwing projection out of the JsVal domain: the model refuses coercion, so a wrong-tag operand throws rather than converts.",
          "additionalProperties": false,
          "required": ["kind", "tag", "expr"],
          "properties": {
            "kind": { "const": "project" },
            "tag": { "enum": ["number", "boolean"] },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "Injection into an option slot: some with the operand, none without it.",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "option" },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A presence test on an option slot.",
          "additionalProperties": false,
          "required": ["kind", "expr", "present"],
          "properties": {
            "kind": { "const": "option-test" },
            "expr": { "$ref": "#/definitions/expr" },
            "present": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "description": "The throwing projection out of an option slot, the twin of project; unreachable behind its test, present so the rendering is total.",
          "additionalProperties": false,
          "required": ["kind", "expr"],
          "properties": {
            "kind": { "const": "option-get" },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A typeof test on a union-typed operand against one of the eight typeof results.",
          "additionalProperties": false,
          "required": ["kind", "expr", "result"],
          "properties": {
            "kind": { "const": "typeof-test" },
            "expr": { "$ref": "#/definitions/expr" },
            "result": {
              "enum": [
                "number",
                "string",
                "bigint",
                "boolean",
                "undefined",
                "object",
                "function",
                "symbol"
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "JS equality over JsVal operands: '===' as strict, Object.is as same-value; neither coerces, so cross-tag is false.",
          "additionalProperties": false,
          "required": ["kind", "semantics", "left", "right"],
          "properties": {
            "kind": { "const": "jsval-eq" },
            "semantics": { "enum": ["strict", "same-value"] },
            "left": { "$ref": "#/definitions/expr" },
            "right": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "An unmodelable site: the opaque its owner declares, applied to the variables in scope there. Valued in JsM, so every use lifts.",
          "additionalProperties": false,
          "required": ["kind", "owner", "site", "args"],
          "properties": {
            "kind": { "const": "residual" },
            "owner": { "$ref": "#/definitions/residualOwner" },
            "module": { "$ref": "#/definitions/modulePath" },
            "site": { "type": "integer", "minimum": 1 },
            "args": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "params", "source", "body"],
      "properties": {
        "kind": { "const": "function" },
        "name": { "$ref": "#/definitions/identifier" },
        "module": { "$ref": "#/definitions/modulePath" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/definitions/param" },
          "description": "Parameters in declaration order, each with its declared type."
        },
        "source": {
          "type": "string",
          "description": "The declaration's original text, echoed as comments above the def."
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/definitions/statement" }
        },
        "returns": {
          "const": "boolean",
          "description": "Present exactly for a boolean-returning declaration; absent means number."
        },
        "noncomputable": {
          "const": true,
          "description": "Present exactly when the body reaches a residual site, directly or through a callee that does; a valueless opaque compiles to 'pure', which the evaluation rung would prove through."
        },
        "ast": {
          "$ref": "tarski-estree.schema.json#/definitions/Program",
          "description": "The ESTree of the declaration's dependency closure, as tarski's parser bridge produced it: a strict script whose statements are, in module order, the top-level declarations the declaration reaches — imported constants, callees, the classes it names — and the declaration itself. The emitter selects statements and writes no node. Absent when no closed script could be assembled: a binding renamed on import, or one name declared by two modules of the closure."
        }
      }
    },
    "class": {
      "type": "object",
      "description": "A class: a structure over its fields, each a number, a boolean, a keyword union, or an instance of an earlier class, a constructor assigning each exactly once on every path, and one function per modeled getter or method.",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "source",
        "fields",
        "ctor",
        "getters",
        "methods"
      ],
      "properties": {
        "kind": { "const": "class" },
        "name": { "$ref": "#/definitions/identifier" },
        "module": { "$ref": "#/definitions/modulePath" },
        "source": {
          "type": "string",
          "description": "The declaration's original text, echoed as comments above the structure."
        },
        "fields": {
          "type": "array",
          "description": "Fields in declaration order — the structure's fields, and the constructor's arguments in order.",
          "items": { "$ref": "#/definitions/field" }
        },
        "ctor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["params", "body"],
          "properties": {
            "params": {
              "type": "array",
              "items": { "$ref": "#/definitions/param" }
            },
            "body": {
              "type": "array",
              "items": { "$ref": "#/definitions/statement" }
            },
            "noncomputable": {
              "const": true,
              "description": "Present exactly when the body reaches a residual site, directly or through a callee that does; a valueless opaque compiles to 'pure', which the evaluation rung would prove through."
            }
          }
        },
        "getters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "body"],
            "properties": {
              "name": { "$ref": "#/definitions/identifier" },
              "body": {
                "type": "array",
                "items": { "$ref": "#/definitions/statement" }
              },
              "returns": {
                "const": "boolean",
                "description": "Present exactly for a boolean-returning declaration; absent means number."
              },
              "noncomputable": {
                "const": true,
                "description": "Present exactly when the body reaches a residual site, directly or through a callee that does; a valueless opaque compiles to 'pure', which the evaluation rung would prove through."
              }
            }
          }
        },
        "methods": {
          "type": "array",
          "description": "Modeled instance methods in declaration order; each is a function of the instance and its parameters.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "params", "body"],
            "properties": {
              "name": { "$ref": "#/definitions/identifier" },
              "params": {
                "type": "array",
                "items": { "$ref": "#/definitions/param" }
              },
              "body": {
                "type": "array",
                "items": { "$ref": "#/definitions/statement" }
              },
              "returns": {
                "const": "boolean",
                "description": "Present exactly for a boolean-returning declaration; absent means number."
              },
              "noncomputable": {
                "const": true,
                "description": "Present exactly when the body reaches a residual site, directly or through a callee that does; a valueless opaque compiles to 'pure', which the evaluation rung would prove through."
              }
            }
          }
        },
        "ast": {
          "$ref": "tarski-estree.schema.json#/definitions/Program",
          "description": "The ESTree of the class's dependency closure, as tarski's parser bridge produced it: a strict script whose statements are, in module order, the top-level declarations the class reaches — imported constants, callees, the classes it names — and the class itself. Its members share it, since a member's replay runs the class's own program. The emitter selects statements and writes no node. Absent when no closed script could be assembled: a binding renamed on import, or one name declared by two modules of the closure."
        }
      }
    },
    "constant": {
      "type": "object",
      "description": "A module-level const whose initializer is a constant expression: a named value rendered as a JsNumber def that preserves the source's derivation.",
      "additionalProperties": false,
      "required": ["kind", "name", "init", "source"],
      "properties": {
        "kind": { "const": "constant" },
        "name": { "$ref": "#/definitions/identifier" },
        "module": { "$ref": "#/definitions/modulePath" },
        "init": {
          "$ref": "#/definitions/expr",
          "description": "The initializer as written: numeric literals, the NaN/Infinity atoms, reads of constants admitted above it, and the whitelisted builtin constants, under the arithmetic operators, unary sign, and whitelisted number-valued builtin calls over such arguments."
        },
        "source": {
          "type": "string",
          "description": "The declaration's original text, echoed as comments above the def."
        },
        "ast": {
          "$ref": "tarski-estree.schema.json#/definitions/Program",
          "description": "The ESTree of the declaration's dependency closure, as tarski's parser bridge produced it: a strict script whose statements are, in module order, the top-level declarations the declaration reaches — imported constants, callees, the classes it names — and the declaration itself. The emitter selects statements and writes no node. Absent when no closed script could be assembled: a binding renamed on import, or one name declared by two modules of the closure."
        }
      }
    },
    "residualOwner": {
      "type": "string",
      "pattern": "^[$A-Za-z_][$A-Za-z0-9_]*(#[$A-Za-z_][$A-Za-z0-9_]*)?$",
      "description": "The callable that owns a residual site: 'f', or 'C#member' with 'constructor' for a constructor's own."
    },
    "residual": {
      "type": "object",
      "description": "One residual site: the opaque its owner declares for an unmodelable expression, over the modeled variables in scope there, carrying the refusal text that names the construct. Emitted ahead of its owner.",
      "additionalProperties": false,
      "required": ["kind", "owner", "site", "construct", "params", "type"],
      "properties": {
        "kind": { "const": "residual" },
        "owner": { "$ref": "#/definitions/residualOwner" },
        "module": { "$ref": "#/definitions/modulePath" },
        "site": {
          "type": "integer",
          "minimum": 1,
          "description": "From 1, in source order within the owner."
        },
        "construct": {
          "type": "string",
          "minLength": 1,
          "description": "The refusal's reason text, which names the construct."
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/definitions/param" },
          "description": "The receiver first inside a member, then the variables in scope."
        },
        "type": {
          "$ref": "#/definitions/paramType",
          "description": "The codomain; the renderer wraps it in JsM, since unmodeled code may throw."
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expr"],
          "properties": {
            "kind": { "const": "return" },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error"],
          "properties": {
            "kind": { "const": "throw" },
            "error": {
              "$ref": "#/definitions/identifier",
              "description": "The thrown error's constructor name; the message is discarded."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "init"],
          "properties": {
            "kind": {
              "enum": ["const", "let"],
              "description": "A local binding: 'const' is immutable, 'let' is a mutable local rendered as Lean's `let mut`."
            },
            "name": { "$ref": "#/definitions/identifier" },
            "init": { "$ref": "#/definitions/expr" },
            "type": {
              "description": "Present exactly for a boolean-, union-, or class-typed local; absent means the numeric slice the statement always had.",
              "oneOf": [
                { "const": "boolean" },
                { "$ref": "#/definitions/unionTags" },
                { "$ref": "#/definitions/classRef" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "expr"],
          "properties": {
            "kind": { "const": "assign" },
            "name": {
              "$ref": "#/definitions/identifier",
              "description": "The mutable local (or parameter) being reassigned."
            },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "description": "A constructor's this.F = e; every field is assigned exactly once on every path.",
          "additionalProperties": false,
          "required": ["kind", "field", "expr"],
          "properties": {
            "kind": { "const": "field-set" },
            "field": { "$ref": "#/definitions/fieldName" },
            "expr": { "$ref": "#/definitions/expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cond", "then"],
          "properties": {
            "kind": { "const": "if" },
            "cond": {
              "$ref": "#/definitions/expr",
              "description": "A boolean-valued expression: a comparison, a SameValue call, or a logical combination of them; truthiness has no model."
            },
            "then": {
              "type": "array",
              "items": { "$ref": "#/definitions/statement" }
            },
            "else": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/statement" },
              "description": "Absent when the source has no else arm (or an empty one): control falls through to the statements after the if."
            }
          }
        },
        {
          "type": "object",
          "description": "An expression statement: evaluated for its effect, value dropped.",
          "additionalProperties": false,
          "required": ["kind", "expr"],
          "properties": {
            "kind": { "const": "discard" },
            "expr": { "$ref": "#/definitions/expr" }
          }
        }
      ]
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "property", "formula", "payload"],
      "properties": {
        "function": {
          "type": "string",
          "description": "Qualified function name — the annotation identity's function."
        },
        "property": { "type": "string" },
        "formula": {
          "type": "string",
          "description": "Whitespace-normalized formula, echoed as a comment above the command."
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "binders", "conclusion"],
              "properties": {
                "kind": { "const": "structured" },
                "binders": {
                  "type": "array",
                  "description": "Nested binders, outermost first: a half-open [lo, hi) Int range with decimal-string endpoints, the whole int line, the naturals, the two booleans, or a number binder over the doubles its bounds admit.",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "kind", "lo", "hi"],
                        "properties": {
                          "name": { "$ref": "#/definitions/identifier" },
                          "kind": { "const": "range" },
                          "lo": { "type": "string", "pattern": "^-?[0-9]+$" },
                          "hi": { "type": "string", "pattern": "^-?[0-9]+$" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "kind"],
                        "properties": {
                          "name": { "$ref": "#/definitions/identifier" },
                          "kind": { "enum": ["int", "nat", "boolean"] }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "kind"],
                        "properties": {
                          "name": { "$ref": "#/definitions/identifier" },
                          "kind": { "const": "number" },
                          "lower": { "$ref": "#/definitions/floatBound" },
                          "upper": { "$ref": "#/definitions/floatBound" }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "kind", "className", "ctorParams"],
                        "properties": {
                          "name": { "$ref": "#/definitions/identifier" },
                          "kind": { "const": "class" },
                          "className": { "$ref": "#/definitions/identifier" },
                          "module": { "$ref": "#/definitions/modulePath" },
                          "ctorParams": {
                            "type": "array",
                            "items": { "$ref": "#/definitions/ctorParamNode" }
                          }
                        }
                      }
                    ]
                  }
                },
                "guards": {
                  "type": "array",
                  "minItems": 1,
                  "description": "Guard antecedents, outermost first, inside every binder; each must evaluate to true for the conclusion to be claimed. Absent when the formula has none.",
                  "items": { "$ref": "#/definitions/expr" }
                },
                "conclusion": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "left", "right"],
                      "properties": {
                        "kind": { "const": "eq" },
                        "left": { "$ref": "#/definitions/expr" },
                        "right": { "$ref": "#/definitions/expr" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "expr"],
                      "properties": {
                        "kind": { "const": "istrue" },
                        "expr": { "$ref": "#/definitions/expr" }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "bare" } }
            }
          ]
        }
      }
    }
  }
}
