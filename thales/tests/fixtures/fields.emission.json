      "source": "export class Cell {\n  readonly value: number | undefined;\n  readonly inner: Inner;\n  readonly n: number;\n  constructor(n: number, i: Inner) {\n    if (n < 0) {\n      this.value = undefined;\n    } else {\n      this.value = n;\n    }\n    this.inner = i;\n    this.n = n;\n  }\n  /** @ensures{keepsN} forall (a: number) { Object.is(new Cell(a, new Inner(a)).n, a) } */\n  get plain(): number {\n    return this.n;\n  }\n}",
