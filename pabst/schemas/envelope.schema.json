{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lakatos.test/schemas/envelope.schema.json",
  "title": "Lakatos Envelope",
  "description": "The JSON report of one lakatos run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "startedAt", "cwd", "annotations"],
  "properties": {
    "version": { "type": "string" },
    "startedAt": { "type": "string" },
    "cwd": { "type": "string" },
    "seed": { "type": "integer" },
    "generated": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/definitions/annotation" }
    }
  },
  "definitions": {
    "functionName": {
      "type": "string",
      "description": "Bare function name, or Class#member (instance) / Class.member (static). A class member is a method, a getter, or the constructor, which is named Class#constructor.",
      "pattern": "^[$A-Za-z_][$A-Za-z0-9_]*([#.][$A-Za-z_][$A-Za-z0-9_]*)?$"
    },
    "counterexample": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["number", "boolean", "string"] }
    },
    "model": {
      "description": "Whether the prover's model of the annotated declaration was proved equal to the evaluator's run of the declaration's own syntax tree on every typed input. unvalidated carries the reason: a construct the model has no run for, a proof that did not reduce, a budget, or a declaration no obligation was stated for.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "validated" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unvalidated" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "annotation": {
      "oneOf": [
        {
          "title": "unattempted or unrefuted",
          "description": "reason, when present, is the prover's account of why it stopped (GaveUp), never started (NotTried), or ran out of budget (Timeout). model, when present, is the prover's account of its model of the declaration.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "enum": ["GaveUp", "NotTried", "Timeout"] },
            "reason": { "type": "string", "minLength": 1 },
            "model": { "$ref": "#/definitions/model" }
          }
        },
        {
          "title": "interrupted",
          "description": "Processing stopped at the user's request: a termination signal reached the run before this annotation was evaluated. reason names the signal.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "User" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "unsupported range",
          "description": "The prover never attempted the property: a range endpoint exceeds the safe integer range, so the bounded domain cannot be represented faithfully. reason names the offending endpoint(s).",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "NotTried" },
            "kind": { "const": "unsupported-range" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "proven",
          "description": "The prover established the property. axioms lists the non-standard axioms the proof depends on: empty for a kernel-checked proof, and e.g. Lean.ofReduceBool for one admitted from compiled evaluation. model says whether the prover's model of the declaration was itself proved equal to the evaluator's run of the declaration's syntax tree.",
          "additionalProperties": false,
          "required": [
            "file",
            "function",
            "property",
            "szs",
            "axioms",
            "model"
          ],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Theorem" },
            "axioms": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "model": { "$ref": "#/definitions/model" }
          }
        },
        {
          "title": "enumerated",
          "description": "The refuter evaluated every tuple of the annotation's finite domain and none failed; cases is the tuple count. The claim is about the observed executions under the runtime that ran them, so it carries no axioms.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "cases"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Theorem" },
            "kind": { "const": "enumerated" },
            "cases": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "title": "budget",
          "description": "The refuter's enumeration ran out of wall clock before walking the whole domain: neither established nor refuted. reason says how far it got.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Timeout" },
            "kind": { "const": "budget" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "inappropriate",
          "description": "The code the annotation depends on is outside the mappable subset; reason names the offending construct. model, when present, is the prover's account of its model of the declaration.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Inappropriate" },
            "reason": { "type": "string", "minLength": 1 },
            "model": { "$ref": "#/definitions/model" }
          }
        },
        {
          "title": "input error",
          "description": "The annotation's input is malformed at extraction (duplicate property name, inaccessible subject), or the program it describes does not type check; error carries the diagnostic. The function label is best-effort: subjects without a proper name use placeholders such as <anonymous>#m or Box#<computed>.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "type": "string", "minLength": 1 },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "InputError" },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "prover error",
          "description": "The prover failed on this annotation before reaching a verdict on the property itself; error carries the diagnostic.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Error" },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "falsified",
          "description": "The property is false of the annotated declaration and counterexample is the witness. From the prover the entry may carry model, its account of its model of the declaration; the refuter never sets it.",
          "additionalProperties": false,
          "required": [
            "file",
            "function",
            "property",
            "szs",
            "kind",
            "counterexample"
          ],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "CounterSatisfiable" },
            "kind": { "const": "falsified" },
            "counterexample": { "$ref": "#/definitions/counterexample" },
            "model": { "$ref": "#/definitions/model" }
          }
        },
        {
          "title": "threw",
          "additionalProperties": false,
          "required": [
            "file",
            "function",
            "property",
            "szs",
            "kind",
            "counterexample",
            "error"
          ],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Error" },
            "kind": { "const": "threw" },
            "counterexample": { "$ref": "#/definitions/counterexample" },
            "error": { "type": "string" }
          }
        },
        {
          "title": "exhausted",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "GaveUp" },
            "kind": { "const": "exhausted" },
            "error": { "type": "string" }
          }
        }
      ]
    }
  }
}
