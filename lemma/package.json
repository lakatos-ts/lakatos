{
  "name": "@lakatos/lemma",
  "version": "0.1.0",
  "description": "The Lemma annotation language and lakatos's TypeScript front end: discovery of annotated files, @ensures extraction, the formula parser, binder domains, the typecheck gate, the parser bridge to ESTree, thales's emitter, and the lemma bin that prints a checked-program document per file.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lemma": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "schemas",
    "spec/README.md",
    "spec/grammar.ebnf",
    "spec/semantics.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakatos-ts/lakatos.git",
    "directory": "lemma"
  },
  "homepage": "https://github.com/lakatos-ts/lakatos#readme",
  "bugs": {
    "url": "https://github.com/lakatos-ts/lakatos/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "fast-check": "^4.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
