{
  "name": "@lakatos/tarski",
  "version": "0.1.1",
  "description": "The JavaScript semantics behind lakatos: the test262 harness for the evaluator binary",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tarski-test262": "dist/test262/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakatos-ts/lakatos.git",
    "directory": "tarski"
  },
  "homepage": "https://github.com/lakatos-ts/lakatos#readme",
  "bugs": {
    "url": "https://github.com/lakatos-ts/lakatos/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@lakatos/lemma": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
