{
  "name": "lakatos",
  "version": "0.1.0",
  "description": "Proofs and refutations for TypeScript.",
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakatos-ts/lakatos.git"
  },
  "homepage": "https://github.com/lakatos-ts/lakatos#readme",
  "bugs": {
    "url": "https://github.com/lakatos-ts/lakatos/issues"
  },
  "bin": {
    "lakatos": "dist/src/cli.js",
    "tarski-test262": "dist/tarski/frontend/src/test262/cli.js"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/engines/pabst/src/runtime.d.ts",
      "default": "./dist/engines/pabst/src/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "fast-check": "^4.8.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.8.0",
    "prettier": "3.9.7"
  }
}
